<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Payment Cancelled — ENG Sports</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      width: 100%;
      min-height: 100%;
    }

    body {
      font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #3b2d1f 50%, #1f190f 100%);
      width: 100%;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      overflow-x: hidden;
    }

    .card {
      width: 100%;
      max-width: 500px;
      padding: 32px 20px;
      text-align: center;
      background: rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .logo {
      color: rgba(255, 255, 255, 0.85);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    .logo span {
      color: #f59e0b;
    }

    .cancel-icon {
      width: 72px;
      height: 72px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      box-shadow: 0 0 35px rgba(245, 158, 11, 0.4);
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 35px rgba(245, 158, 11, 0.4); }
      50% { box-shadow: 0 0 55px rgba(245, 158, 11, 0.7); }
    }

    .cancel-icon svg {
      width: 38px;
      height: 38px;
      stroke: #ffffff;
      stroke-width: 3;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .badge {
      display: inline-block;
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #fbbf24;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 5px 14px;
      border-radius: 100px;
      margin-bottom: 16px;
    }

    h1 {
      color: #ffffff;
      font-size: 24px;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 10px;
    }

    p.subtitle {
      color: rgba(255, 255, 255, 0.7);
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .info-box {
      width: 100%;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      padding: 14px 16px;
      margin-bottom: 20px;
      text-align: left;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      padding: 9px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-label {
      flex: 0 0 auto;
      color: rgba(255, 255, 255, 0.5);
      font-size: 13px;
      font-weight: 500;
    }

    .info-value {
      min-width: 0;
      max-width: 75%;
      color: #ffffff;
      font-size: 13px;
      font-weight: 600;
      text-align: right;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .info-value.amber {
      color: #fbbf24;
    }

    .cancel-detail {
      background: rgba(245, 158, 11, 0.08);
      border: 1px solid rgba(245, 158, 11, 0.2);
      border-radius: 12px;
      padding: 13px 15px;
      margin-bottom: 20px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 12px;
      line-height: 1.6;
      text-align: left;
    }

    .cancel-detail strong {
      color: #ffffff;
    }

    .footer-text {
      margin-top: 20px;
      color: rgba(255, 255, 255, 0.4);
      font-size: 11px;
      line-height: 1.6;
    }

    /* Media query for medium/larger screens */
    @media (min-width: 520px) {
      body {
        padding: 20px;
      }

      .card {
        padding: 44px 36px;
      }

      .cancel-icon {
        width: 80px;
        height: 80px;
      }

      .cancel-icon svg {
        width: 42px;
        height: 42px;
      }

      h1 {
        font-size: 26px;
      }

      p.subtitle {
        font-size: 15px;
      }

      .info-box {
        padding: 16px 20px;
      }
    }

    /* Small phone optimization */
    @media (max-width: 360px) {
      body {
        padding: 6px;
      }

      .card {
        padding: 24px 14px;
        border-radius: 16px;
      }

      h1 {
        font-size: 21px;
      }

      p.subtitle {
        font-size: 13px;
      }

      .info-box {
        padding: 12px 12px;
      }

      .info-label, .info-value {
        font-size: 12px;
      }
    }
  </style>
</head>

<body>

  <div class="card">

    <div class="logo">
      ENG <span>Sports</span> Events
    </div>

    <div class="cancel-icon">
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </svg>
    </div>

    <div class="badge">
      Payment Cancelled
    </div>

    <h1>Checkout Was Cancelled</h1>

    <p class="subtitle">
      You exited the payment process before completing the transaction.
      No charges have been made to your card or account.
    </p>

    <div class="info-box">

      <div class="info-row">
        <span class="info-label">Status</span>
        <span class="info-value amber">⚠ Cancelled</span>
      </div>

      <div class="info-row">
        <span class="info-label">Note</span>
        <span class="info-value">
          <%= errorMessage || 'Payment process was cancelled by user' %>
        </span>
      </div>

      <div class="info-row">
        <span class="info-label">Date</span>
        <span class="info-value">
          <%= date %>
        </span>
      </div>

    </div>

    <div class="cancel-detail">
      <strong>Want to complete your subscription?</strong><br />
      You can return to the ENG Sports app at any time and select your desired subscription package to try again.
    </div>

    <p class="footer-text">
      No money was deducted from your account.<br />
      ENG Sports Events © <%= year %>
    </p>

  </div>

</body>

</html>
