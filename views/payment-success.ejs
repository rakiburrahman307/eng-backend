<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Successful — ENG Sports</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0f2a1a 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .card {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;
      padding: 56px 48px;
      max-width: 520px;
      width: 100%;
      text-align: center;
      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    }

    .success-icon {
      width: 90px;
      height: 90px;
      background: linear-gradient(135deg, #22c55e, #16a34a);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 32px;
      box-shadow: 0 0 40px rgba(34, 197, 94, 0.4);
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        box-shadow: 0 0 40px rgba(34, 197, 94, 0.4);
      }

      50% {
        box-shadow: 0 0 60px rgba(34, 197, 94, 0.7);
      }
    }

    .success-icon svg {
      width: 48px;
      height: 48px;
      stroke: #ffffff;
      stroke-width: 3;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .badge {
      display: inline-block;
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid rgba(34, 197, 94, 0.4);
      color: #4ade80;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 6px 16px;
      border-radius: 100px;
      margin-bottom: 20px;
    }

    h1 {
      color: #ffffff;
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 14px;
      line-height: 1.3;
    }

    p.subtitle {
      color: rgba(255, 255, 255, 0.6);
      font-size: 15px;
      line-height: 1.7;
      margin-bottom: 36px;
    }

    .info-box {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      padding: 20px 24px;
      margin-bottom: 32px;
      text-align: left;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-label {
      color: rgba(255, 255, 255, 0.45);
      font-size: 13px;
    }

    .info-value {
      color: #ffffff;
      font-size: 13px;
      font-weight: 600;
    }

    .info-value.green {
      color: #4ade80;
    }

    .btn {
      display: inline-block;
      background: linear-gradient(135deg, #22c55e, #16a34a);
      color: #ffffff;
      text-decoration: none;
      font-size: 15px;
      font-weight: 600;
      padding: 14px 36px;
      border-radius: 12px;
      transition: all 0.2s ease;
      border: none;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(34, 197, 94, 0.35);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(34, 197, 94, 0.5);
    }

    .footer-text {
      margin-top: 28px;
      color: rgba(255, 255, 255, 0.3);
      font-size: 12px;
    }

    .logo {
      color: rgba(255, 255, 255, 0.8);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 36px;
    }

    .logo span {
      color: #22c55e;
    }
  </style>
</head>

<body>
  <div class="card">
    <div class="logo">ENG <span>Sports</span> Events</div>

    <div class="success-icon">
      <svg viewBox="0 0 24 24">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <div class="badge">Payment Successful</div>

    <h1>Your Subscription is Active!</h1>
    <p class="subtitle">
      Your payment has been processed successfully. Your child’s profile is now under review. We will notify you once
      the review is completed and the profile is approved.
    </p>

    <div class="info-box">
      <div class="info-row">
        <span class="info-label">Status</span>
        <span class="info-value green">✓ Active</span>
      </div>
      <div class="info-row">
        <span class="info-label">Session ID</span>
        <span class="info-value">
          <%= sessionId || 'N/A' %>
        </span>
      </div>
      <div class="info-row">
        <span class="info-label">Package</span>
        <span class="info-value">
          <%= packageName || 'ENG Subscription Plan' %>
        </span>
      </div>
      <div class="info-row">
        <span class="info-label">Date</span>
        <span class="info-value">
          <%= date %>
        </span>
      </div>
    </div>

    <p class="footer-text">
      A confirmation will be sent to your registered email.<br />
      ENG Sports Events © <%= year %>
    </p>
  </div>
</body>

</html>