<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  />

  <title>Payment Successful — ENG Sports</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      width: 100%;
      min-height: 100%;
    }

    body {
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;

      background: linear-gradient(
        135deg,
        #0f172a 0%,
        #1e3a5f 50%,
        #0f2a1a 100%
      );

      width: 100%;
      min-height: 100vh;
      min-height: 100dvh;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 16px;

      overflow-x: hidden;
    }

    .card {
      width: 100%;
      max-width: 520px;

      padding: 40px 32px;

      text-align: center;

      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);

      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 24px;

      box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    }

    .logo {
      color: rgba(255, 255, 255, 0.8);

      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;

      margin-bottom: 30px;
    }

    .logo span {
      color: #22c55e;
    }

    .success-icon {
      width: 80px;
      height: 80px;

      background: linear-gradient(
        135deg,
        #22c55e,
        #16a34a
      );

      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 26px;

      box-shadow: 0 0 40px rgba(34, 197, 94, 0.4);

      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%,
      100% {
        box-shadow: 0 0 40px rgba(34, 197, 94, 0.4);
      }

      50% {
        box-shadow: 0 0 60px rgba(34, 197, 94, 0.7);
      }
    }

    .success-icon svg {
      width: 42px;
      height: 42px;

      stroke: #ffffff;
      stroke-width: 3;
      fill: none;

      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .badge {
      display: inline-block;

      background: rgba(34, 197, 94, 0.15);
      border: 1px solid rgba(34, 197, 94, 0.4);

      color: #4ade80;

      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;

      padding: 6px 14px;
      border-radius: 100px;

      margin-bottom: 18px;
    }

    h1 {
      color: #ffffff;

      font-size: 27px;
      font-weight: 700;
      line-height: 1.3;

      margin-bottom: 12px;
    }

    p.subtitle {
      color: rgba(255, 255, 255, 0.6);

      font-size: 14px;
      line-height: 1.7;

      margin-bottom: 30px;
    }

    .info-box {
      width: 100%;

      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.1);

      border-radius: 14px;

      padding: 16px 18px;

      margin-bottom: 24px;

      text-align: left;
    }

    .info-row {
      display: flex;

      justify-content: space-between;
      align-items: flex-start;

      gap: 16px;

      padding: 9px 0;

      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .info-row:last-child {
      border-bottom: none;
    }

    .info-label {
      flex: 0 0 auto;

      color: rgba(255, 255, 255, 0.45);

      font-size: 12px;
    }

    .info-value {
      min-width: 0;
      max-width: 70%;

      color: #ffffff;

      font-size: 12px;
      font-weight: 600;

      text-align: right;

      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .info-value.green {
      color: #4ade80;
    }

    .footer-text {
      margin-top: 24px;

      color: rgba(255, 255, 255, 0.3);

      font-size: 11px;
      line-height: 1.6;
    }

    /* Tablet and larger devices */

    @media (min-width: 481px) {
      body {
        padding: 24px;
      }

      .card {
        padding: 48px 40px;
      }

      .success-icon {
        width: 86px;
        height: 86px;
      }

      .success-icon svg {
        width: 46px;
        height: 46px;
      }

      h1 {
        font-size: 28px;
      }

      p.subtitle {
        font-size: 15px;
      }

      .info-box {
        padding: 18px 20px;
      }

      .info-label,
      .info-value {
        font-size: 13px;
      }

      .footer-text {
        font-size: 12px;
      }
    }

    /* Small mobile devices */

    @media (max-width: 380px) {
      body {
        padding: 10px;
      }

      .card {
        padding: 28px 18px;
        border-radius: 18px;
      }

      .logo {
        font-size: 11px;
        margin-bottom: 24px;
      }

      .success-icon {
        width: 68px;
        height: 68px;

        margin-bottom: 20px;
      }

      .success-icon svg {
        width: 36px;
        height: 36px;
      }

      .badge {
        font-size: 10px;
        letter-spacing: 1.2px;

        padding: 5px 12px;

        margin-bottom: 14px;
      }

      h1 {
        font-size: 22px;
        line-height: 1.3;

        margin-bottom: 10px;
      }

      p.subtitle {
        font-size: 13px;
        line-height: 1.6;

        margin-bottom: 22px;
      }

      .info-box {
        padding: 12px 14px;

        margin-bottom: 18px;
      }

      .info-row {
        gap: 10px;

        padding: 8px 0;
      }

      .info-label,
      .info-value {
        font-size: 11px;
      }

      .info-value {
        max-width: 65%;
      }

      .footer-text {
        margin-top: 20px;
        font-size: 10px;
      }
    }

    /* Very small devices */

    @media (max-width: 320px) {
      body {
        padding: 8px;
      }

      .card {
        padding: 24px 14px;
        border-radius: 16px;
      }

      .logo {
        font-size: 10px;
      }

      .success-icon {
        width: 62px;
        height: 62px;
      }

      .success-icon svg {
        width: 32px;
        height: 32px;
      }

      h1 {
        font-size: 20px;
      }

      p.subtitle {
        font-size: 12px;
      }

      .info-box {
        padding: 10px 11px;
      }

      .info-row {
        gap: 8px;
      }

      .info-label,
      .info-value {
        font-size: 10px;
      }

      .info-value {
        max-width: 64%;
      }

      .footer-text {
        font-size: 9px;
      }
    }
  </style>
</head>

<body>

  <div class="card">

    <div class="logo">
      ENG <span>Sports</span> Events
    </div>

    <div class="success-icon">
      <svg viewBox="0 0 24 24">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <div class="badge">
      Payment Successful
    </div>

    <h1>
      Your Subscription is Active!
    </h1>

    <p class="subtitle">
      Your payment has been processed successfully.
      Your child’s profile is now under review.
      We will notify you once the review is completed
      and the profile is approved.
    </p>

    <div class="info-box">

      <div class="info-row">
        <span class="info-label">
          Status
        </span>

        <span class="info-value green">
          ✓ Active
        </span>
      </div>

      <div class="info-row">
        <span class="info-label">
          Session ID
        </span>

        <span class="info-value">
          <%= sessionId || 'N/A' %>
        </span>
      </div>

      <div class="info-row">
        <span class="info-label">
          Package
        </span>

        <span class="info-value">
          <%= packageName || 'ENG Subscription Plan' %>
        </span>
      </div>

      <div class="info-row">
        <span class="info-label">
          Date
        </span>

        <span class="info-value">
          <%= date %>
        </span>
      </div>

    </div>

    <p class="footer-text">
      A confirmation will be sent to your registered email.<br />
      ENG Sports Events © <%= year %>
    </p>

  </div>

</body>

</html>